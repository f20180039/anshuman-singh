# ===== PRODUCTION FRONTEND (FE) VARIABLES =====
# This file is SAFE to commit - contains only public URLs
# Used by Vite during production build (npm run build)

# Render Backend API URL (publicly accessible)
VITE_API_URL=https://anshuman-singh.onrender.com

# GitHub Pages Base URL (repository name)
VITE_BASE_URL=/anshuman-singh/

# Google Analytics 4 measurement ID (format: G-XXXXXXXXXX).
# Public by design — it identifies the property, it does not authorise access.
# While blank, no analytics script loads and the cookie banner stays hidden.
VITE_GA_MEASUREMENT_ID=

# Web3Forms access key for the /contact form. Public by design: it only permits
# submissions that are delivered to the inbox registered with that key.
# While blank, the form falls back to opening a prefilled mailto: draft.
VITE_WEB3FORMS_KEY=

# NOTE: Backend secrets (GOOGLE_API_KEY, etc.) are set in Render dashboard,
# NOT in this file. They should NEVER be committed to the repository.
