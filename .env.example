# ===== FRONTEND (FE) VARIABLES =====
# These are used by Vite during build/dev (prefixed with VITE_)

VITE_BASE_URL=/anshuman-singh/

# API URL for local development (points to local backend)
VITE_API_URL=http://localhost:3001

# Google Analytics 4 measurement ID (public — safe to commit in .env.production).
# Leave blank to disable analytics entirely: no gtag.js request is made and the
# cookie banner does not render, because there is nothing to consent to.
VITE_GA_MEASUREMENT_ID=

# Web3Forms access key for the /contact form (public by design — the key only
# authorises submissions to your own inbox). Get one at https://web3forms.com.
# If blank, the form falls back to opening a prefilled mailto: draft.
VITE_WEB3FORMS_KEY=

# ===== BACKEND (BE) VARIABLES =====
# These are used by the Express server (NOT prefixed with VITE_)

# Google Gemini API Key (SECRET - keep in .env, never commit)
# Get yours at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here

# Server Configuration
PORT=3001
NODE_ENV=development

# CORS Origins (comma-separated for production)
# Example for production: https://yourdomain.com,https://www.yourdomain.com
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
