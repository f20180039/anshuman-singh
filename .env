# ===== FRONTEND (FE) VARIABLES =====
# These are used by Vite during build/dev (prefixed with VITE_)

VITE_BASE_URL=/anshuman-singh/

# API URL for local development (points to local backend)
VITE_API_URL=http://localhost:3001

# ===== BACKEND (BE) VARIABLES =====
# These are used by the Express server (NOT prefixed with VITE_)

# Google Gemini API Key (SECRET - keep in .env, never commit)
# Get yours at: https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=AQ.Ab8RN6IVsOEEVw2U-If0wpphDZ-yP18EhcxvLpMIzxOXqspvVQ1

# Server Configuration
PORT=3001
NODE_ENV=development

# CORS Origins (comma-separated for production)
# Example: https://yourdomain.com,https://www.yourdomain.com
CORS_ORIGINS=http://localhost:5173
